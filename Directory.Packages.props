<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- YAML frontmatter parsing for vault_search_frontmatter. -->
    <PackageVersion Include="YamlDotNet"                        Version="18.1.0" />

    <!-- Configuration for the CLI (the MCP host gets these via ASP.NET Core) -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json"                 Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder"               Version="11.0.0" />

    <!-- MCP server -->
    <PackageVersion Include="ModelContextProtocol"              Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore"   Version="2.4.0" />
    <!-- Cloudflare Access assertion validation at the origin (AccessAuth). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk"            Version="18.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing"  Version="11.0.0" />
    <PackageVersion Include="xunit"                             Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio"         Version="4.0.1" />
    <PackageVersion Include="Shouldly"                          Version="4.3.0" />
    <PackageVersion Include="coverlet.collector"                Version="10.1.1" />
  </ItemGroup>

</Project>
