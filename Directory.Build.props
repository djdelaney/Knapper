<Project>

  <PropertyGroup>
    <!-- THE Knapper version: single source of truth for every binary.
         Surfaced to MCP clients via initialize.serverInfo.version.
         Bump it with `ops/release.sh`, never by hand — the script is what
         keeps the tag, the commit, and this property describing one build. -->
    <Version>0.3.1</Version>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
    <!-- The SDK ships SourceLink on by default and, left alone, appends
         "+<40-char sha>" to InformationalVersion by itself. That LOOKS like
         build identity and is not: it reports HEAD's sha whether or not the
         tree was modified, so the one case worth catching — a binary built off
         uncommitted edits — stamps itself identically to the clean tag. The
         KnapperStampRevision target below writes the field instead; this
         switches off the SDK's version so the two cannot both append. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Knapper is Unix-only BY DESIGN: the mutation contract stands on
       flock(2) advisory locks, link(2) no-clobber commits, rename(2)
       atomicity, and preserved Unix file modes. Production is a Debian LXC;
       dev is macOS. These assembly attributes (applied to every project)
       make the platform analyzer enforce that instead of demanding guards
       for a platform the service will never run on. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatform">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatform">
      <_Parameter1>macos</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Stamp the git revision into AssemblyInformationalVersion, so the string
       every runtime surface reports (Knapper.Core.BuildInfo → serverInfo.version,
       /health, /up, `knapper version`) identifies a BUILD and not merely a
       release number: 0.2.0+g1f5ff1c, or 0.2.0+g1f5ff1c.dirty off an uncommitted
       tree. Without it, a tarball hand-built off any commit reports the same
       "0.2.0" as the tagged release at every surface, so a wrong binary in
       production is indistinguishable from the right one — the deployment check
       (`knapper verify` against a live URL, with an expected version) has
       nothing to compare. NB: XML comments cannot contain a double hyphen,
       which is why the flag names are spelled out in prose here.

       Written straight into InformationalVersion rather than by setting
       SourceRevisionId for the SDK to append: the SDK's own append runs from
       GetAssemblyAttributes' DependsOnTargets, which execute BEFORE any
       BeforeTargets hook on it, so a SourceRevisionId set here would land too
       late to be read. Hence the property above turning that path off, leaving
       exactly one writer of the field.

       ops/version.sh is the ONE implementation of the identity, shared with
       publish.sh and release.sh; it fails the build on a malformed <Version>
       and prints an empty revision (no failure) outside a git checkout, so a
       source archive still builds and reports a bare, self-describing "0.2.0". -->
  <Target Name="KnapperStampRevision" BeforeTargets="GetAssemblyAttributes"
          Condition="'$(GenerateAssemblyInfo)' != 'false'">
    <Exec Command="./ops/version.sh --revision" WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_KnapperRevision" />
    </Exec>
    <PropertyGroup Condition="'$(_KnapperRevision)' != ''">
      <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
      <InformationalVersion Condition="!$(InformationalVersion.Contains('+'))">$(InformationalVersion)+$(_KnapperRevision)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
