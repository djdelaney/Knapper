# Deploy config for ops/deploy.sh — copy to ~/.config/knapper/deploy.env
# (or point KNAPPER_DEPLOY_ENV at it) and fill in YOUR deployment's values.
# ops/deploy.sh SOURCES this file, so it is code: keep it yours, mode 600, and
# never commit it. Every value below is a placeholder (example.com and the
# 192.0.2.0/24 documentation range).

# ── Required ─────────────────────────────────────────────────────────────
# ssh destination of the host running knapper.service (root, or a user that
# can run systemctl, runuser and write the install directory).
KNAPPER_CT_SSH=root@192.0.2.10
# The Access-fronted public URL `knapper verify` goes through. https, trailing /.
KNAPPER_PUBLIC_URL=https://mcp.example.com/

# ── Optional ─────────────────────────────────────────────────────────────
# Extra ssh/scp options, e.g. a jump host when off the service host's LAN.
#KNAPPER_SSH_OPTS="-J root@jump.example.com"
# Host running the external monitor; set to force one run at closeout (§11).
# Unset = no forced run, and the closeout says so.
#KNAPPER_MONITOR_SSH=root@monitor.example.com
#KNAPPER_MONITOR_UNIT=knapper-monitor.service
# Defaults shown.
#KNAPPER_INSTALL_DIR=/opt/knapper
#KNAPPER_VERIFY_ENV=/root/.knapper-verify.env
#KNAPPER_LOGDIR="$HOME/knapper-deploys"

# ── Environment the running unit must ALWAYS carry (§6b, §8) ───────────────
# Knobs whose ABSENCE IS SILENT: unset, the service starts, doctor is all-ok,
# verify is green, and the feature simply does nothing. Checked on EVERY
# deploy — a standing assertion, not migration scaffolding; do not prune an
# entry once "the deploy that needed it" is done.
#   KEY=VALUE  the unit must carry exactly this assignment
#   KEY        presence only — use this for a value containing whitespace
REQUIRED_ENV=(
  # "Vault__ArchivedPrefixes__0=Archive"
  # "Conventions__WikilinksOnly=true"
  # "Conventions__NoNewFrontmatter=true"
  # "Conventions__NoNewTags=true"
  # "Conventions__NewNoteFolder=Inbox"
  # "Conventions__Style"
  # "Mcp__VaultName"
)
