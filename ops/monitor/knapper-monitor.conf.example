# /etc/knapper-monitor.conf — knapper-monitor.sh configuration (Proxmox host).
# chmod 600: CF_CLIENT_SECRET is a credential.
UP_URL="https://mcp.example.com/up"
CF_CLIENT_ID="<monitoring-service-token>.access"
CF_CLIENT_SECRET="<monitoring-service-token-secret>"
CT_ID=106
STAMP_PATH=/var/lib/knapper/commit-stamp
MAX_STAMP_AGE=3900
MAILTO=alerts@example.com
# Where `--test` mails go. Point MAILTO here too while running the §8 failure
# drills, so injected failures never sit in the stream beside real ones.
TEST_MAILTO=failtest@example.com
# An unchanged failure set re-notifies at most this often (default 24h). A
# Sync conflict file blocks writes until a human reconciles it; that is days,
# not minutes, and one mail per interval would train the operator to ignore it.
RENOTIFY_SECONDS=86400
CURL_TIMEOUT=20
METRICS_PATH=/var/lib/knapper/metrics.json
STATE_DIR=/var/lib/knapper-monitor
# Per-window delta thresholds (window = one monitor interval, default 5 min).
MAX_AUDIT_FAILURES=0
MAX_QUERY_TIMEOUTS=5
MAX_TOOL_ERRORS=50
MAX_STALE_REJECTIONS=25
MAX_TRUNCATED=100
MAX_GENERATION_CHANGED=100
