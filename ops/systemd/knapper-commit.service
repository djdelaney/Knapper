# The vault's git snapshot job (brief §10): runs `knapper commit` under the
# vault-wide commit lock. Pairs with knapper-commit.timer.
[Unit]
Description=Knapper vault git snapshot

[Service]
Type=oneshot
User=knapper
Group=knapper
WorkingDirectory=/opt/knapper/cli
ExecStart=/opt/knapper/cli/knapper commit
Environment=Vault__RootPath=/vault
Environment=Vault__LockDirectory=/var/lib/knapper/locks
# No Vault__AuditLogPath here, deliberately: the commit job writes no audit
# entry — the commit itself IS the record, and GitCommitJob takes neither the
# audit log nor the sync gate. A path listed here would only imply otherwise,
# and send someone hunting for entries that were never going to appear.
# The external monitor's git-freshness signal: touched (fsynced) on every
# successful run including "nothing to commit" — last-commit age can't tell
# a quiet vault from a dead timer.
Environment=Vault__CommitStampPath=/var/lib/knapper/commit-stamp

# Hardening, mirroring knapper.service: this unit runs git with WRITE access
# to the vault — it gets no more filesystem than that.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/vault /var/lib/knapper
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
