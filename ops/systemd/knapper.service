# Knapper MCP server — the single authoritative agent interface to /vault.
# Install: copy to /etc/systemd/system/, adjust paths, systemctl enable --now knapper
[Unit]
Description=Knapper MCP server (Obsidian vault interface)
After=network-online.target obsidian-headless.service
Wants=network-online.target

[Service]
Type=simple
User=knapper
Group=knapper
WorkingDirectory=/opt/knapper/mcp
ExecStart=/opt/knapper/mcp/Knapper.Mcp
Restart=on-failure
RestartSec=5

# Logging. stdout/stderr go to journald (systemd's default); the service
# writes no log file — ProtectSystem=strict below leaves /var/log read-only.
# Tags entries so `journalctl -t knapper` works, not just `-u knapper`.
SyslogIdentifier=knapper
# Rate limiting OFF for this unit. journald's default burst discards messages
# once a unit gets loud, and the loudest moment a service ever has is the
# crash loop you are trying to read — evidence would be dropped exactly when
# it matters, silently. The disk backstop is journald's SystemMaxUse cap
# (runbook §3), not throttling at the source.
LogRateLimitIntervalSec=0
LogRateLimitBurst=0

# Configuration via environment (overrides appsettings.json).
Environment=Vault__RootPath=/vault
Environment=Vault__LockDirectory=/var/lib/knapper/locks
Environment=Vault__AuditLogPath=/var/lib/knapper/audit.jsonl
# Bounded counters snapshot the external monitor reads (rates as deltas).
Environment=Vault__MetricsPath=/var/lib/knapper/metrics.json
Environment=Sync__Mode=heartbeat
Environment=Sync__HeartbeatPath=/var/lib/knapper/sync-heartbeat
# The fail-closed budget, stated here even though it is the default: with the
# heartbeat probe running every 60s, this is how long continuous sync can be
# dead before mutations stop. Left to appsettings.json it would be invisible
# to anyone reading the unit to find out.
Environment=Sync__MaxAgeSeconds=300
Environment=Mcp__BindAddress=127.0.0.1
Environment=Mcp__Port=3535
Environment=Mcp__AllowedHosts__0=mcp.example.com
# Access origin validation: set these when the Cloudflare Access apps exist —
# BOTH of them, in one edit. Runbook §6.2 creates both before §6.3 edits this
# file, so this block is filled in once and the service restarts once.
#Environment=Mcp__Access__Enabled=true
#Environment=Mcp__Access__TeamDomain=https://YOURTEAM.cloudflareaccess.com
#Environment=Mcp__Access__Audience=YOUR_ACCESS_APP_AUD
# ⛔ The FOURTH line is not optional dressing, and leaving it out is not the
# neutral choice it looks like. Empty MonitoringAudience is the SINGLE-APP
# COLLAPSE: /up then accepts the owner AUD, so the monitor authenticates with
# the vault's own token and the credential sitting in /etc/knapper-monitor.conf
# on ANOTHER machine can read and mutate every note. It boots clean, `doctor`
# reads all-ok, `/health` and `/up` are green, and `knapper verify` SKIPS the
# check that would catch it (no CF_MONITOR_* pair to test with). The server
# logs a warning at startup and that is the only signal.
# Two apps is the default. Take one only deliberately — runbook §6.4.
#Environment=Mcp__Access__MonitoringAudience=YOUR_UP_APP_AUD

# Hardening. ReadWritePaths lists exactly what the service may touch.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/vault /var/lib/knapper
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
